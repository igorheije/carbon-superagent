exports[`renderK8s > renders the expected files (snapshot) 1`] = `
{
  "README.md": "# Carbon worker — maquina-sp-01 (Kubernetes)

Este kit cria o namespace \`carbon-maquina-sp-01\` com 2 réplica(s) do worker do Carbon, que pegam
tarefas do painel em \`https://carbon.exemplo.local:3418\`. Cada réplica roda até 3 tarefa(s) ao mesmo
tempo com: claude, codex. Recursos por réplica: 1500m CPU, 4Gi de memória.

## Antes de aplicar

1. Abra o \`secret.yaml\` e preencha as credenciais do modelo e o \`CARBON_GIT_TOKEN\` (descomente as linhas).
2. Publique a imagem \`ghcr.io/acme/carbon-worker:0.2.0\` (ela não vem pronta). No repositório do Carbon, na mesma versão do painel:
   \`docker buildx build -f deploy/worker/Dockerfile --platform linux/amd64,linux/arm64 -t ghcr.io/acme/carbon-worker:0.2.0 --push .\`
3. O \`secret.yaml\` contém o token da máquina: não versione. Em produção, prefira Sealed Secrets ou External Secrets.

## Aplicar

\`\`\`sh
kubectl apply -k .
\`\`\`

## Escalar

\`\`\`sh
kubectl -n carbon-maquina-sp-01 scale deployment/carbon-worker --replicas=N
\`\`\`

## Logs

\`\`\`sh
kubectl -n carbon-maquina-sp-01 logs -f -l app.kubernetes.io/name=carbon-worker --max-log-requests=20
\`\`\`

## Parar e atualizar

Ao remover um pod, o worker para de pegar tarefas e espera as atuais terminarem por até
540s (\`terminationGracePeriodSeconds: 600\`).

## Revogar o token

1. No painel, Configurações → Máquinas → **Revogar** em "maquina-sp-01". O worker para de receber tarefas na hora.
2. No cluster: \`kubectl delete -k .\` (apaga o namespace \`carbon-maquina-sp-01\` e o secret).
3. Para voltar a usar, gere um kit novo (token novo) no painel.
",
  "deployment.yaml": "apiVersion: "apps/v1"
kind: "Deployment"
metadata:
  name: "carbon-worker"
  namespace: "carbon-maquina-sp-01"
  labels:
    app.kubernetes.io/name: "carbon-worker"
    app.kubernetes.io/instance: "maquina-sp-01"
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: "carbon-worker"
      app.kubernetes.io/instance: "maquina-sp-01"
  template:
    metadata:
      labels:
        app.kubernetes.io/name: "carbon-worker"
        app.kubernetes.io/instance: "maquina-sp-01"
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 600
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile:
          type: "RuntimeDefault"
      containers:
        - name: "worker"
          image: "ghcr.io/acme/carbon-worker:0.2.0"
          imagePullPolicy: "IfNotPresent"
          envFrom:
            - secretRef:
                name: "carbon-worker"
          env:
            - name: "CARBON_PANEL_URL"
              value: "https://carbon.exemplo.local:3418"
            - name: "CARBON_WORKER_PARALLEL"
              value: "3"
            - name: "CARBON_WORKER_EXECUTORS"
              value: "claude,codex"
            - name: "CARBON_WORKER_DIR"
              value: "/home/carbon/work"
            - name: "CARBON_WORKER_GRACE_SECONDS"
              value: "540"
            - name: "HOME"
              value: "/home/carbon"
          resources:
            requests:
              cpu: "1500m"
              memory: "4Gi"
            limits:
              cpu: "1500m"
              memory: "4Gi"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - "ALL"
          volumeMounts:
            - name: "home"
              mountPath: "/home/carbon"
            - name: "tmp"
              mountPath: "/tmp"
      volumes:
        - name: "home"
          emptyDir: {}
        - name: "tmp"
          emptyDir: {}
",
  "kustomization.yaml": "apiVersion: "kustomize.config.k8s.io/v1beta1"
kind: "Kustomization"
namespace: "carbon-maquina-sp-01"
resources:
  - "namespace.yaml"
  - "secret.yaml"
  - "deployment.yaml"
  - "networkpolicy.yaml"
",
  "namespace.yaml": "apiVersion: "v1"
kind: "Namespace"
metadata:
  name: "carbon-maquina-sp-01"
  labels:
    app.kubernetes.io/name: "carbon-worker"
    app.kubernetes.io/instance: "maquina-sp-01"
",
  "networkpolicy.yaml": "# Nenhuma entrada; saída liberada (painel, API do modelo, git, DNS).
# Para restringir a saída, troque \`egress\` por regras com ipBlock/porta do seu ambiente.
apiVersion: "networking.k8s.io/v1"
kind: "NetworkPolicy"
metadata:
  name: "carbon-worker"
  namespace: "carbon-maquina-sp-01"
  labels:
    app.kubernetes.io/name: "carbon-worker"
    app.kubernetes.io/instance: "maquina-sp-01"
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: "carbon-worker"
      app.kubernetes.io/instance: "maquina-sp-01"
  policyTypes:
    - "Ingress"
    - "Egress"
  ingress: []
  egress:
    - {}
",
  "secret.yaml": "# Contém o token da máquina: NÃO versione. Prefira um gerenciador de segredos (Sealed Secrets, External Secrets).
apiVersion: "v1"
kind: "Secret"
metadata:
  name: "carbon-worker"
  namespace: "carbon-maquina-sp-01"
  labels:
    app.kubernetes.io/name: "carbon-worker"
    app.kubernetes.io/instance: "maquina-sp-01"
type: "Opaque"
stringData:
  CARBON_WORKER_TOKEN: "cwk_FakeTokenForTests0123456789-_abcdefghijklmn"
  # Credenciais do modelo — descomente e preencha. Claude Code: UMA das duas
  # (chave da API da Anthropic, ou token gerado com \`claude setup-token\`).
  # ANTHROPIC_API_KEY: ""
  # CLAUDE_CODE_OAUTH_TOKEN: ""
  # Codex (só se a imagem foi gerada com WITH_CODEX=true):
  # OPENAI_API_KEY: ""
  # Git: token com permissão de clone e push (https).
  # CARBON_GIT_TOKEN: ""
  # Hosts que podem receber o token (vírgula). Sem esta linha o token nunca é enviado.
  # CARBON_GIT_HOSTS: "github.com"
",
}
`;
